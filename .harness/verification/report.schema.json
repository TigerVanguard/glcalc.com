{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glcalc.com/schemas/verification-report.schema.json",
  "title": "GLCalc Verification Report",
  "description": "Machine-readable output produced by the GLCalc verification agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "project",
    "status",
    "summary",
    "issues"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for a verification run."
    },
    "project": {
      "type": "string",
      "const": "glcalc.com"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "blocked"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app_url": {
          "type": "string",
          "minLength": 1
        },
        "node_version": {
          "type": "string"
        },
        "browser": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandResult"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testCaseResult"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "output_summary": {
          "type": "string"
        }
      }
    },
    "testCaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(CALC|SEARCH|BAR|PHOTO|ERR|UI|REG)-[0-9]{3}(\\+)?$"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "priority_if_broken": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "status",
        "area",
        "test_case",
        "severity_reason",
        "expected_result",
        "actual_result",
        "evidence",
        "fix_guidance",
        "must_have_regression_test"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GLAC-VER-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "stalled",
            "blocked"
          ]
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "test_case": {
          "type": "string",
          "pattern": "^(CALC|SEARCH|BAR|PHOTO|ERR|UI|REG)-[0-9]{3}(\\+)?$"
        },
        "severity_reason": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string"
        },
        "steps_to_reproduce": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "actual_result": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "suspected_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fix_guidance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_have_regression_test": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
