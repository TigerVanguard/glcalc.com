{
  "installCommand": "npm install && npx playwright install chromium --only-shell",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "glcalc.vercel.app" }],
      "destination": "https://glucomath.com/$1",
      "permanent": true
    }
  ]
}
